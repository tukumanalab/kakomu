# Maintainer: Junya Ishihara <junya@champierre.com>

# ビルド済みの binary を Releases から取ってきて入れる版。
# ソースからビルドする版は AUR の kakomu にある。
pkgname=kakomu-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="アクリルスタンド・アクリルキーホルダーを作るためのベクターエディタ"
arch=('x86_64')
url="https://github.com/tukumanalab/kakomu"
license=('MIT')

# 画面の描画に要るもの。これが無いと起動しない
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'librsvg'
  # ファイルを開くダイアログ。Tauri は xdg-desktop-portal 越しに出す。
  # FileChooser を実装しているのは -gtk なので、これが実体として要る
  'xdg-desktop-portal'
  'xdg-desktop-portal-gtk'
)
optdepends=(
  'xdg-desktop-portal-hyprland: Hyprland で portal を正しく振り分けるため（omarchy では入れておく）'
)
provides=('kakomu')
conflicts=('kakomu')
options=('!strip' '!debug')

# deb には LICENSE が入っていないので、タグから別に取ってくる
source=(
  "${pkgname}-${pkgver}.deb::${url}/releases/download/v${pkgver}/kakomu_${pkgver}_amd64.deb"
  "LICENSE-${pkgver}::${url}/raw/v${pkgver}/LICENSE"
)
# 1 つめが deb、2 つめが LICENSE。update.sh が書き換える
sha256sums=('899a23cf2baed368c22498b431752c94333df59880eb5b0bd1ee23067037c97c' '78c384537f1ac73a60cade835693da1d45950de276a958f14ab8fbfa56799a7e')

package() {
  # deb は ar 書庫。中身の data.tar.* を展開すれば所定の場所に収まる。
  # 入っているのは usr/bin/kakomu と .desktop、アイコン一式
  bsdtar -xf "${pkgname}-${pkgver}.deb" -C "${srcdir}"
  bsdtar -xf "${srcdir}"/data.tar.* -C "${pkgdir}"

  install -Dm644 "${srcdir}/LICENSE-${pkgver}" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
